# BenefitPulse requires Supabase + Gemini. The API will not start without them.
APP_ENV=development
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Google Gemini (required) — https://aistudio.google.com/apikey
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
EMBEDDING_MODEL=models/gemini-embedding-001
GEMINI_FALLBACK_MODELS=gemini-flash-latest,gemini-2.5-flash,gemini-2.0-flash

# Supabase (required) — Project Settings → API
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# Optional
SUPABASE_SYNC=true
CHROMA_REINDEX=false
